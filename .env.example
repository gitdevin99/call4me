# Public Supabase project credentials. Apply supabase/schema.sql first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only. Never prefix secret keys with VITE_. Use a newly rotated key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
PORT=3001

# Server only. Never prefix these keys with VITE_.
GOOGLE_PLACES_API_KEY=
BRAVE_SEARCH_API_KEY=
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
TELNYX_ASSISTANT_ID=
TELNYX_PUBLIC_KEY=

# Either twilio (default) or telnyx. Never automatically retry across providers.
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# These must point to your implemented public HTTPS voice bridge and signed callback handler.
TWILIO_VOICE_URL=
TWILIO_STATUS_CALLBACK_URL=

# Direct OpenAI is preferred when provided; OpenRouter remains supported.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Render: set HOST=0.0.0.0. PORT is supplied by Render.
HOST=127.0.0.1
WHOP_API_KEY=

# Production server-only configuration. Never prefix secrets with VITE_.
PUBLIC_ORIGIN=https://canyoucall.app
DATABASE_URL=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false
CALLS_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime
CALL_RATE_CENTS_PER_MINUTE=60
